# =============================================================================
# Local / private files — not part of the published plugin.
# =============================================================================
/CLAUDE.md
/.claude/
.omc/
*.pdf

# (.claude-plugin/ is the PUBLIC plugin manifest — intentionally NOT ignored.)

# =============================================================================
# Secrets / BYOK keys
# =============================================================================
.env
.env.*
!.env.example
*.key
*.pem

# =============================================================================
# Whisper model weights — downloaded at first run into ${CLAUDE_PLUGIN_DATA}.
# Never commit weights (multi-GB).
# =============================================================================
*.bin
*.gguf
/models/

# =============================================================================
# Node / TypeScript
# =============================================================================
node_modules/
dist/
build/
out/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# =============================================================================
# Throwaway prototypes — kept next to the code, never shipped.
# =============================================================================
*.prototype.*

# demo harness (kept local — only docs/demo.gif ships)
demo/

# QA reproduction set (kept local — dev asset; plugin installs copy the whole repo)
qa-macos/

# README media (served from the GitHub release, not the tree — installs copy the repo)
docs/demo.gif
docs/popup.png
