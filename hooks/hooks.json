{
  "description": "STP plugin hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-model.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
